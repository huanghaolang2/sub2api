{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "vue": ["./node_modules/vue"],
      "pinia": ["./node_modules/pinia"],
      "vue-router": ["./node_modules/vue-router"],
      "vue-i18n": ["./node_modules/vue-i18n"],
      "axios": ["./node_modules/axios"],
      "@shared-api": ["../frontend/src/api/index.ts"],
      "@shared-api/*": ["../frontend/src/api/*"],
      "@shared-stores/*": ["../frontend/src/stores/*"],
      "@shared-composables/*": ["../frontend/src/composables/*"],
      "@shared-i18n/*": ["../frontend/src/i18n/*"],
      "@shared-utils/*": ["../frontend/src/utils/*"],
      "@shared-prompt-audit/*": ["../frontend/src/features/prompt-audit/*"],
      "@shared-captcha": ["../frontend/src/components/CaptchaChallenge.vue"],
      "@/components/TurnstileWidget.vue": ["../frontend/src/components/TurnstileWidget.vue"],
      "@/components/TencentCaptchaGate.vue": ["../frontend/src/components/TencentCaptchaGate.vue"],
      "@/components/AliyunCaptchaWidget.vue": ["../frontend/src/components/AliyunCaptchaWidget.vue"],
      "@/utils/tencentCaptcha": ["../frontend/src/utils/tencentCaptcha.ts"],
      "@/api": ["../frontend/src/api/index.ts"],
      "@/api/*": ["../frontend/src/api/*"],
      "@/types": ["../frontend/src/types/index.ts"],
      "@/types/payment": ["../frontend/src/types/payment.ts"],
      "@/constants/channel": ["../frontend/src/constants/channel.ts"],
      "@/constants/channelMonitor": ["../frontend/src/constants/channelMonitor.ts"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts", "vitest.config.ts"]
}
