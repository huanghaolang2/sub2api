# Non-secret production preset. Loaded after deploy/.env by the root Makefile.
# Update SUB2API_WORKSPACE_IMAGE_TAG for every release; never use
# latest/local/dev/prod in production.
SUB2API_WORKSPACE_MODE=prod
SUB2API_WORKSPACE_IMAGE_TAG=20260819.1
SUB2API_WORKSPACE_BIND_HOST=127.0.0.1
SUB2API_WORKSPACE_SERVER_MODE=release
SUB2API_WORKSPACE_LOG_ENV=production
SUB2API_WORKSPACE_LOG_FORMAT=json
SUB2API_WORKSPACE_LOG_CALLER=false
SUB2API_WORKSPACE_FRONTEND_READ_ONLY=true
