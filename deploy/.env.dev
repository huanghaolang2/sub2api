# Non-secret development preset. Loaded after deploy/.env by the root Makefile.
# Keep local services on loopback; override BIND_HOST explicitly for LAN tests.
SUB2API_WORKSPACE_MODE=dev
SUB2API_WORKSPACE_IMAGE_TAG=dev
SUB2API_WORKSPACE_BIND_HOST=127.0.0.1
SUB2API_WORKSPACE_SERVER_MODE=debug
SUB2API_WORKSPACE_LOG_ENV=development
SUB2API_WORKSPACE_LOG_FORMAT=console
SUB2API_WORKSPACE_LOG_CALLER=true
SUB2API_WORKSPACE_FRONTEND_READ_ONLY=false
