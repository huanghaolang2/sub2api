# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24-alpine
ARG NGINX_IMAGE=nginx:alpine

FROM ${NODE_IMAGE} AS dependencies

ARG APP_DIR

RUN case "${APP_DIR}" in frontend|frontend2) ;; *) echo "APP_DIR must be frontend or frontend2" >&2; exit 1 ;; esac

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /workspace/${APP_DIR}

COPY ${APP_DIR}/package.json ${APP_DIR}/pnpm-lock.yaml ./
RUN --mount=type=cache,id=sub2api-vite-pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline

COPY ${APP_DIR}/ ./

# frontend2 intentionally reuses API, stores, types, and business utilities
# from frontend/src through Vite aliases. The extra copy is harmless when
# APP_DIR=frontend and keeps both targets on one reproducible module graph.
COPY frontend/src/ /workspace/frontend/src/
COPY docs/legal/ /workspace/docs/legal/

# Development target: Vite server with the existing Docker-network proxy.
FROM dependencies AS dev

ENV NODE_ENV=development

EXPOSE 3000

CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]

# Production build target. Both applications emit to one deterministic path,
# avoiding APP_DIR-specific COPY instructions in the runtime image.
FROM dependencies AS builder

RUN pnpm exec vue-tsc -b && \
    pnpm exec vite build --outDir /workspace/dist --emptyOutDir

FROM ${NGINX_IMAGE} AS prod

COPY deploy/nginx.vite.conf /etc/nginx/nginx.conf
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=builder --chown=nginx:nginx /workspace/dist/ /usr/share/nginx/html/

USER nginx

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -T 3 -O /dev/null http://127.0.0.1:3000/ || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
