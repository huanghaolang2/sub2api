# Copy to .env.local on the server. Keep the real file out of Git.

# The dashboard must be reachable from the reporter container.
DASHBOARD_URL=http://sub2api:8080/dashboard
DASHBOARD_STORAGE_STATE=/data/dashboard-storage-state.json
# Optional first-login fallback. Prefer a pre-created storage state for 2FA accounts.
DASHBOARD_LOGIN_EMAIL=
DASHBOARD_LOGIN_PASSWORD=
DASHBOARD_TIMEOUT_MS=60000
DASHBOARD_SETTLE_MS=1500

# To match the inline screenshot example, use app mode. The app must be added to
# the target group and have message/image permissions.
FEISHU_TRANSPORT=app
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=oc_xxx
FEISHU_MENTION_OPEN_IDS=ou_xxx,ou_yyy

# Webhook fallback. In webhook mode the screenshot is sent as a public link.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# UTC+8 is the requested Monday 08:00 schedule timezone.
REPORT_TIMEZONE=Asia/Shanghai
REPORT_TITLE=cyds 看板周报
REPORT_FILE_PREFIX=cyds-dashboard
REPORT_DRY_RUN=false

# COS adapter. The default contract is:
# POST COS_UPLOAD_URL with {filename, content_type, size}
# -> {upload_url, public_url}; then PUT the PNG to upload_url.
# app mode can set this to disabled because Feishu stores the inline image.
COS_UPLOAD_MODE=disabled
COS_UPLOAD_URL=
COS_UPLOAD_URL_FIELD=upload_url
COS_PUBLIC_URL_FIELD=public_url
COS_UPLOAD_HEADERS_JSON={}

# Alternative direct multipart adapter:
# COS_UPLOAD_MODE=multipart
# COS_UPLOAD_URL=https://example/upload
# COS_PUBLIC_URL_FIELD=url
